# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Anthropic API key used to power the conversational AI agent
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Telegram numeric chat id of the realtor who should receive instant
# notifications about hot leads and reactions to listings.
REALTOR_CHAT_ID=

# Database (SQLite file by default, works out of the box for the MVP).
# On Railway, add a PostgreSQL plugin and point this at its DATABASE_URL
# instead (postgres:// and postgresql:// are both accepted and rewritten to
# the async driver automatically) — needed so the bot and web services,
# which run as separate processes, see the same data.
DATABASE_URL=sqlite+aiosqlite:///./data/realtor_bot.db

# Realtor cabinet (web dashboard)
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_SECRET_KEY=change-me-in-production
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=change-me

# RIELTOR.UA is a Ukrainian site and irrelevant for the Montenegro market —
# left empty so the external search is skipped and only the internal
# database is used. Fill this in again if/when the Ukrainian version
# (branch telegram-chatbot-ukrainian) is revived.
RIELTOR_UA_MAX_PRICE_USD=100000
RIELTOR_UA_ALLOWED_CITIES=
RIELTOR_UA_BASE_URL=https://rieltor.ua
RIELTOR_UA_REQUEST_TIMEOUT=10
